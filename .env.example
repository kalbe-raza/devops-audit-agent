# Copy to .env and fill in. Never commit .env.
# Required: Anthropic API key used by the agent's LLM calls.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional settings (defaults shown)
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium            # low | medium | high | xhigh | max
# MAX_STEPS=40                 # maximum assistant turns per audit
# MAX_TOOL_OUTPUT_CHARS=10000  # truncation limit for one tool result
# AUDIT_TIMEOUT=1800           # overall time budget (seconds)
# CLONE_TIMEOUT=300            # git clone timeout (seconds)
# TOOL_TIMEOUT=60              # per git/ruff command timeout (seconds)
# ENABLE_DOCKER_TESTS=auto     # auto | false - sandboxed pytest via Docker
# SANDBOX_IMAGE=python:3.12-slim
# SANDBOX_TIMEOUT=600
